{#
  A page rendered from a Markdown file: a trust framework section, a contents
  page, or the feedback guidance.
#}
{% extends "layouts/base.njk" %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}

{% set isFramework = repoPath.startsWith("trust-framework-1.0/") %}
{% set part = repoPath | partOf %}
{% set isContents = repoPath == "trust-framework-1.0/README.md" %}
{% set isPartPage = repoPath.endsWith("/README.md") and not isContents %}

{% block breadcrumbs %}
  {% set crumbs = [{ text: "Home", href: "/" }] %}
  {% if isFramework and not isContents %}
    {% set crumbs = (crumbs.push({ text: "Contents", href: "/trust-framework-1.0/" }), crumbs) %}
  {% endif %}
  {% if part and not isPartPage %}
    {% set crumbs = (crumbs.push({ text: "Part " + part, href: "/trust-framework-1.0/part-" + part + "/" }), crumbs) %}
  {% endif %}
  {{ govukBreadcrumbs({ items: crumbs, collapseOnMobile: true }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop app-prose">
      {% if isFramework %}<span class="govuk-caption-l">Trust framework working draft</span>{% endif %}
      <h1 class="govuk-heading-xl">{{ title }}</h1>

      {# Only when this page's wording differs from the framework baseline. #}
      {% set frameworkChange = repoPath | frameworkChangeFor if isFramework else null %}
      {% if frameworkChange %}
        <div class="govuk-inset-text app-section-changed">
          This section has changed since {{ frameworkChanges.baseline.name }}.
          <a class="govuk-link" href="/changes/{{ frameworkChange.slug }}/">See what has changed</a>.
        </div>
      {% endif %}

      {# Rule-level feedback, on pages with numbered rules. #}
      {% set ruleGroups = content | ruleGroups %}
      {% if ruleGroups | length %}
        <p class="govuk-body"><a class="govuk-link govuk-visually-hidden-focusable" href="#rule-feedback">Skip to give feedback on a specific rule</a></p>
      {% endif %}

      {# Subsections, and the headings under each, so long sections can be navigated. See lib/contents.js. #}
      {% set contents = content | pageContents %}
      {% if (contents | contentsLength) >= 3 %}
        <nav class="app-contents-list" aria-labelledby="on-this-page">
          <h2 class="govuk-heading-s" id="on-this-page">On this page</h2>
          <ul class="govuk-list app-contents-list__list">
            {% for item in contents %}
              <li>
                <a class="govuk-link" href="#{{ item.id }}">{{ item.text }}</a>
                {% if item.children | length %}
                  <ul class="govuk-list app-contents-list__sublist">
                    {% for child in item.children %}
                      <li><a class="govuk-link" href="#{{ child.id }}">{{ child.text }}</a></li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}

      {{ content | safe }}

      {% if isFramework %}
        <div class="app-page-actions">
          <h2 class="govuk-heading-m">Give feedback on this page</h2>
          <p class="govuk-body">
            You can raise feedback on GitHub. You need a free GitHub account, and you do not need to suggest new wording.
          </p>
          <ul class="govuk-list">
            <li><a class="govuk-link" href="{{ page.url | pageFeedbackUrl(title) }}">Give feedback on GitHub</a></li>
            <li><a class="govuk-link" href="{{ repositoryUrl }}/commits/main/{{ repoPath }}">See the history of changes to this page</a></li>
            <li><a class="govuk-link" href="{{ repositoryUrl }}/blob/main/{{ repoPath }}">View this page on GitHub</a></li>
          </ul>
          {% if ruleGroups | length %}
            {# Shown by assets/rule-actions.js, because pointing and tapping need it. #}
            <p class="govuk-body-s app-rule-hint" hidden>You can also point to or tap a rule to give feedback on it, or to copy a link to it or its reference.</p>
            <form class="app-rule-picker" id="rule-feedback" action="{{ repositoryUrl }}/issues/new/choose" method="get">
              <div class="govuk-form-group">
                <label class="govuk-label govuk-label--s" for="rule-feedback-reference">Give feedback on a specific rule</label>
                <div class="govuk-hint" id="rule-feedback-hint">Choose a rule, then continue to GitHub.</div>
                <select class="govuk-select" id="rule-feedback-reference" name="reference" aria-describedby="rule-feedback-hint">
                  <option value="">Choose a rule</option>
                  {% for group in ruleGroups %}
                    <optgroup label="{{ group.heading }}">
                      {% for item in group.rules %}<option value="{{ item.reference }}">{{ item.rule }}</option>{% endfor %}
                    </optgroup>
                  {% endfor %}
                </select>
              </div>
              <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">Continue to GitHub</button>
            </form>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  {% if isFramework and not isPartPage and not isContents %}
    {% set sections = collections.sections %}
    {% for item in sections %}
      {% if item.url == page.url %}
        {% set previousItem = sections[loop.index0 - 1] if loop.index0 > 0 else null %}
        {% set nextItem = sections[loop.index0 + 1] if loop.index0 + 1 < sections | length else null %}
        {{ govukPagination({
          previous: { href: previousItem.url, labelText: previousItem.data.title } if previousItem else null,
          next: { href: nextItem.url, labelText: nextItem.data.title } if nextItem else null
        }) }}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endblock %}

{% block bodyEnd %}
  {{ super() }}
  {% if (content | ruleGroups) | length %}<script type="module" src="/assets/rule-actions.js"></script>{% endif %}
{% endblock %}
