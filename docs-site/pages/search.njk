---
permalink: /search/
layout: layouts/base.njk
title: Search the trust framework
---
{#
  Search the trust framework by rule number or by words. The results are
  shown by assets/search.js from the search index (/search-index.json), which
  is made from the trust framework Markdown when the site is built
  (lib/search.js).
#}
{% from "components/search-form.njk" import searchForm %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds-from-desktop">
    <h1 class="govuk-heading-xl">{{ title }}</h1>

    {{ searchForm({ id: "search", label: "Search for a rule number or words", labelClasses: "govuk-label--m" }) }}

    {#
      The search results. Hidden until assets/search.js has loaded and
      started, so the page never offers search that cannot run.
    #}
    <div data-search-enhanced hidden>
      <div data-search-examples>
        <h2 class="govuk-heading-s">Examples</h2>
        <ul class="govuk-list">
          <li><a class="govuk-link" href="/search/?q=12.4.1.c">12.4.1.c</a></li>
          <li><a class="govuk-link" href="/search/?q=identity+repair">identity repair</a></li>
          <li><a class="govuk-link" href="/search/?q=fraud+monitoring">fraud monitoring</a></li>
          <li><a class="govuk-link" href="/search/?q=GPG+45">GPG 45</a></li>
        </ul>
      </div>
      <p class="govuk-visually-hidden" role="status" data-search-status></p>
      <div data-search-output></div>
    </div>

    {#
      Another way to find a rule. Shown unless search has started, so it is
      there without JavaScript, if the search scripts do not load, and if
      the search index cannot be loaded.
    #}
    <div data-search-fallback>
      <div class="govuk-inset-text">
        If search is not available, you can still find a rule by its number. The number starts with its section,
        so rule 12.4.1.c is in section 12. Open the section, then use your browser's find in page
        (often Ctrl+F, or Command+F on a Mac).
      </div>
      <h2 class="govuk-heading-m">Sections of the trust framework</h2>
      <ul class="govuk-list">
        <li><a class="govuk-link" href="/trust-framework-1.0/">Contents</a></li>
        {% for item in collections.sections %}
          <li><a class="govuk-link" href="{{ item.url }}">{{ item.data.title }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
</div>
<script type="module" src="/assets/search.js"></script>
